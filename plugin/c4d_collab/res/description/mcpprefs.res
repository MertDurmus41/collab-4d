CONTAINER mcpprefs
{
	NAME mcpprefs;
	SCALE_V;

	GROUP COLLABMCP_SERVER_GROUP
	{
		DEFAULT 1;
		COLUMNS 1;

		BOOL COLLABMCP_ENABLE				{ ANIM OFF; }
		STRING COLLABMCP_STATUS				{ ANIM OFF; READONLY; }
		STRING COLLABMCP_HOST				{ ANIM OFF; READONLY; }
		LONG COLLABMCP_PORT					{ ANIM OFF; MIN 1024; MAX 65535; }
		STRING COLLABMCP_TOKEN				{ ANIM OFF; READONLY; }
		BOOL COLLABMCP_SHOW_TOKEN			{ ANIM OFF; }
		GROUP
		{
			COLUMNS 2;
			BUTTON COLLABMCP_COPY_TOKEN		{ }
			BUTTON COLLABMCP_REGENERATE_TOKEN	{ }
		}
		REAL COLLABMCP_TIMEOUT				{ ANIM OFF; MIN 0.1; MAX 3600; }
	}

	GROUP COLLABMCP_CLIENTS_GROUP
	{
		DEFAULT 1;
		COLUMNS 1;

		LONG COLLABMCP_CLIENT
		{
			ANIM OFF;
			CYCLE
			{
				COLLABMCP_CLIENT_CLAUDE_DESKTOP;
				COLLABMCP_CLIENT_CLAUDE_CODE;
				COLLABMCP_CLIENT_CODEX;
				COLLABMCP_CLIENT_CURSOR;
				COLLABMCP_CLIENT_OTHER;
			}
		}
		STRING COLLABMCP_CLIENT_STATUS		{ ANIM OFF; READONLY; }
		STRING COLLABMCP_CONFIG_FILE		{ ANIM OFF; READONLY; }
		GROUP
		{
			COLUMNS 3;
			BUTTON COLLABMCP_UPDATE_CLIENT	{ }
			BUTTON COLLABMCP_REMOVE_CLIENT	{ }
			BUTTON COLLABMCP_COPY_CONFIG	{ }
		}
		STATICTEXT COLLABMCP_RESTART_HINT	{ }
	}

	GROUP COLLABMCP_SECURITY_GROUP
	{
		DEFAULT 1;
		COLUMNS 1;

		BOOL COLLABMCP_ALLOW_PYTHON			{ ANIM OFF; }
		BOOL COLLABMCP_LOG_CALLS			{ ANIM OFF; }
		BOOL COLLABMCP_CONSOLE_REJECTIONS	{ ANIM OFF; }
	}

	GROUP COLLABMCP_TOOLSET_GROUP
	{
		DEFAULT 1;
		COLUMNS 1;

		STATICTEXT COLLABMCP_TOOLSET_HINT	{ }
		BOOL COLLABMCP_TOOLSET_BASICS		{ ANIM OFF; }
		BOOL COLLABMCP_TOOLSET_HIERARCHY	{ ANIM OFF; }
		BOOL COLLABMCP_TOOLSET_ENTITIES		{ ANIM OFF; }
		BOOL COLLABMCP_TOOLSET_SYSTEM		{ ANIM OFF; }
	}
}
